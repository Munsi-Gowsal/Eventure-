# Environment
NODE_ENV=production
# The port Render binds to (automatically provided by Render, but required here for local fallback)
PORT=

# MongoDB Connection String (Atlas SRV format)
MONGODB_URI=

# JWT Secrets (Must be at least 32 characters and MUST NOT be identical)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token Expirations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
# The URL of the deployed frontend (e.g., https://your-eventure-frontend.vercel.app)
CLIENT_URL=https://your-eventure-frontend.vercel.app
# A comma-separated list of allowed origins (Must match CLIENT_URL in production)
CORS_ORIGINS=https://your-eventure-frontend.vercel.app
