          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has success === true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "pm.test(\"No password or hashes returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.not.have.property('password');",
                  "    pm.expect(jsonData.data).to.not.have.property('passwordHash');",
                  "    pm.expect(jsonData.data).to.not.have.property('refreshTokenHash');",
                  "});"
                ],
